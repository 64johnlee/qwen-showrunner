# Qwen Cloud (Alibaba Cloud Model Studio) free-tier key — card-free.
# Get one at https://home.qwencloud.com/benefits  (1M tokens/model, no payment method).
DASHSCOPE_API_KEY=sk-your-free-tier-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Video backend: auto = free Qwen chain first, then Veo on GCP credits.
# Requires `gcloud auth login` for the veo/auto fallback.
SHOWRUNNER_VIDEO_BACKEND=auto
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
