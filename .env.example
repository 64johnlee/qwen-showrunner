# Qwen Cloud (Alibaba Cloud Model Studio) free-tier key — card-free.
# Get one at https://home.qwencloud.com/benefits  (1M tokens/model, no payment method).
DASHSCOPE_API_KEY=sk-your-free-tier-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Video backend — "qwen" renders every shot with Wan on Qwen Cloud.
# This is the hackathon-submitted configuration (the demo episode was produced
# this way) and needs nothing beyond the DASHSCOPE key above.
# Optional alternates added post-submission: "auto" = free Qwen/Wan chain first,
# then Veo on GCP credits; "veo" = Veo only. Both need `gcloud auth login`.
SHOWRUNNER_VIDEO_BACKEND=qwen
#GCP_PROJECT=your-gcp-project-id
#GCP_REGION=us-central1
